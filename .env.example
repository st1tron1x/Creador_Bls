APP_NAME="Trade & Business - Plataforma BL"
APP_ENV=local
APP_KEY=                       # se genera con: php artisan key:generate
APP_DEBUG=true
APP_URL=http://localhost:8090

LOG_CHANNEL=stack
LOG_LEVEL=debug

# --- Base de datos: apunta al contenedor "db" del docker-compose ---
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=bl_platform
DB_USERNAME=bl_platform_user
DB_PASSWORD=change_me          # debe coincidir con el valor en docker-compose.yml

SESSION_DRIVER=database
SESSION_LIFETIME=120

QUEUE_CONNECTION=database

CACHE_STORE=database

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
